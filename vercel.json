{
  "headers": [
    {
      "source": "/ss(.*)",
      "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/server" },
    { "source": "/auth", "destination": "/api/server" },
    { "source": "/auth/(.*)", "destination": "/api/server" }
  ],
  "functions": {
    "api/server.js": { "maxDuration": 30 }
  }
}
